# Ambiente de execucao: "development" (local) ou "production" (deploy).
# Em "production" a conexao com o PostgreSQL passa a usar SSL.
NODE_ENV=development

# Porta em que o servidor Express vai rodar
PORT=3000

# String de conexao completa com o PostgreSQL
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/controle_de_gastos

# Segredo usado para assinar os tokens JWT (use um valor longo e aleatorio)
JWT_SECRET=troque-por-um-valor-secreto-bem-longo-e-aleatorio

# Tempo de expiracao do token JWT (ex: 1h, 2h, 7d)
JWT_EXPIRES_IN=2h

# Origem do frontend autorizada no CORS
# Em desenvolvimento pode ser http://localhost:5500 ou http://127.0.0.1:5500
# Em producao, a URL do frontend na Vercel (ex: https://seu-frontend.vercel.app)
CORS_ORIGIN=http://127.0.0.1:5500
